# ── Aashish AI + portfolio · git-ignore ──────────────────────────────
# PII / data hygiene (Aashish_AI_Agent_Prompt_v2.md §17)
.cv-raw.txt
*.docx
data/raw/
data/extracted/
data/processed/
# Stage B instruction data is generated (~31 MB at 40k examples). The
# generator and its manifest are committed; the JSONL is a build output.
data/instruction/sft.jsonl
training/checkpoints/
training/datasets/
experiments/**/*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# ── Trained tokenizer artifacts ──────────────────────────────────────
# The small dev fixture artifact is committed on purpose: the Python test
# suite and `train_smoke.py` read it, so a fresh clone can verify the
# tokenizer contract without retraining. Real P4+ artifacts (12–16k vocab,
# larger corpora) are build outputs and stay out.
ai/tokenizer/artifacts/*
!ai/tokenizer/artifacts/seed-1k/

# ── The exported browser model (§9.3) ────────────────────────────────
# Build output: `inference/export_browser.py --out ai/model-export/<version>`
# quantizes a checkpoint into shards + manifest + tokenizer. It ships from
# `dist/` (tools/build.mjs copies it when present) but is never committed —
# it is derivable from the checkpoint, and a stale copy in the repo would
# silently disagree with the weights it claims to be.
ai/model-export/

# ── Python (training + inference side) ───────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets / env
.env
.env.*
!.env.example

# Dependencies / build output
node_modules/
dist/
build/

# ── Dev-only probe artefacts (never shipped to the browser) ──────────
# probes themselves are dev tooling; their OUTPUT is noise
probe-*.txt
shots-*.txt
baseline-run.txt
baseline-fps*
pacing.log
pacing.txt
*-fps.txt
fps-*.txt
*.log
docs/BASELINE-*.json
shots/
dev-fps-last.png
probe.out.txt
probe.err.txt
# a redirected `npm run test:py > py-tests.txt`
*-tests.txt
.tmp-body.json

# ── One-off recovery leftovers from the corrupt freebuff session ─────
film3d_recovered_0.js
film3d_firsthalf_f_001ac2.txt

# Agent/tooling state (holds only a project id, never anything to ship)
.freebuff/
# Host linkage, same category — and no host has been chosen yet
# (docs/DEPLOYMENT.md §6). Keeping it out of git is reversible: the file
# stays on disk, and committing it later is `git add -f .vercel`.
.vercel/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/