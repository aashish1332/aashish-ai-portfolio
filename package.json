{
  "name": "aashish-kumar-the-film",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic scroll-driven WebGL portfolio — scroll is the timeline, the visitor is the projectionist. The city is the system diagram.",
  "scripts": {
    "dev": "node dev-server.mjs",
    "start": "node server.js",
    "build": "node tools/build.mjs",
    "preview": "node tools/preview.mjs",
    "probe": "node dev-error-probe.js",
    "probe:mobile": "set MOBILE=1&& node dev-error-probe.js",
    "fps": "node dev-fps-probe.js",
    "baseline": "node dev-baseline-probe.js",
    "probe:anchor": "node dev-anchor-probe.js",
    "probe:resources": "node dev-resource-probe.js",
    "calibrate": "node tools/calibrate-retrieval.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests/py -t .",
    "test:all": "npm test && npm run test:py",
    "tokenizer": "python -m ai.tokenizer.train --corpus \"data/raw/seed/*.txt\" --vocab-size 1024 --out ai/tokenizer/artifacts/seed-1k",
    "params": "python inference/count_parameters.py --config all --gate",
    "smoke": "python -m training.scripts.train_smoke --pipeline-only"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "mongoose": "^9.10.1"
  }
}
