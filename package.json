{
  "name": "aashish-kumar-the-film",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic scroll-driven WebGL portfolio — scroll is the timeline, the visitor is the projectionist. The city is the system diagram.",
  "scripts": {
    "dev": "node dev-server.mjs",
    "start": "node server.js",
    "build": "node tools/build.mjs",
    "bundle": "node tools/bundle-report.mjs",
    "preview": "node tools/preview.mjs",
    "probe": "node dev-error-probe.js",
    "probe:mobile": "set MOBILE=1&& node dev-error-probe.js",
    "fps": "node dev-fps-probe.js",
    "baseline": "node dev-baseline-probe.js",
    "probe:anchor": "node dev-anchor-probe.js",
    "probe:resources": "node dev-resource-probe.js",
    "probe:latency": "node dev-answer-latency-probe.js",
    "probe:tokens": "node dev-token-budget-probe.js",
    "probe:offline": "node dev-offline-probe.js",
    "probe:degrade": "node dev-degrade-probe.js",
    "calibrate": "node tools/calibrate-retrieval.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests/py -t .",
    "test:all": "npm test && npm run test:py",
    "tokenizer": "python -m ai.tokenizer.train --corpus \"data/raw/seed/*.txt\" --vocab-size 1024 --out ai/tokenizer/artifacts/seed-1k",
    "params": "python inference/count_parameters.py --config all --gate",
    "bench:cpu": "python inference/benchmark/benchmark_cpu.py --config A --tokens 16 --json docs/CPU_BENCHMARK.json",
    "sft": "python -m training.scripts.make_instruction_data",
    "sft:check": "python -m training.scripts.train_stage_b --pipeline-only",
    "train:sft": "python -m training.scripts.train_stage_b --config local --tokenizer ai/tokenizer/artifacts/seed-1k --data data/instruction/sft.jsonl --init training/checkpoints/local/latest.pt --run-dir training/checkpoints/sft-local --steps 500 --batch 4 --block 256 --grad-accum 2 --lr 5e-5 --warmup 25 --eval-every 100 --save-every 100 --log-every 25 --gate",
    "smoke": "python -m training.scripts.train_smoke --pipeline-only",
    "train:local": "python -m training.scripts.train_smoke --config local --tokenizer ai/tokenizer/artifacts/seed-1k --shards data/processed/seed/shards --run-dir training/checkpoints/local --steps 1100 --batch 8 --block 256 --lr 1.5e-3 --warmup 100 --eval-every 100 --save-every 100 --log-every 25",
    "sample:answers": "python inference/sample_answers.py",
    "eval:prompts": "node tools/model-eval.mjs --emit-prompts docs/EVAL_PROMPTS.json",
    "eval:decode": "python inference/grade_answers.py --prompts docs/EVAL_PROMPTS.json --out docs/EVAL_ANSWERS.json --checkpoint training/checkpoints/sft-local --max-tokens 16",
    "eval:report": "node tools/model-eval.mjs --grade docs/EVAL_ANSWERS.json --json docs/EVALUATION.json",
    "export:model": "python inference/export_browser.py --run-dir training/checkpoints/local --out ai/model-export/aashish-ai-1 --reference-out ai/model-export/reference/aashish-ai-1.json",
    "verify:engine": "node tools/verify-engine.mjs ai/model-export/aashish-ai-1 ai/model-export/reference/aashish-ai-1.json",
    "fixture:engine": "python inference/export_browser.py --random-init --out tests/fixtures/tiny-model --reference-out tests/fixtures/engine_reference.json",
    "contract:prompt": "python inference/export_prompt_contract.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "mongoose": "^9.10.1"
  }
}
